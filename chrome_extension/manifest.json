{
  "manifest_version": 3,
  "name": "Tune-Text AI Prompter (Chạy Tab Bên Cạnh)",
  "version": "1.1.0",
  "description": "Tự động gõ prompt vào tab ChatGPT, Claude, Gemini, DeepSeek, Poe hoặc bất kỳ trang Web AI nào đang mở sẵn bên cạnh mà không cần mở trình duyệt mới.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*",
        "https://localhost:8000/*",
        "https://127.0.0.1:8000/*",
        "https://*.nextdev.name.vn/*",
        "http://*.nextdev.name.vn/*",
        "https://*.trycloudflare.com/*",
        "http://*.trycloudflare.com/*"
      ],
      "js": [
        "content_tunetext.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*",
        "https://localhost:8000/*",
        "https://127.0.0.1:8000/*",
        "https://*.nextdev.name.vn/*",
        "http://*.nextdev.name.vn/*",
        "https://*.trycloudflare.com/*",
        "http://*.trycloudflare.com/*"
      ],
      "js": [
        "content_ai.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
