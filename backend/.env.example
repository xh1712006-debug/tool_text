# Cấu hình môi trường mẫu (Environment Configuration Template)
PROJECT_NAME="Tune-Text Platform"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Cấu hình Cơ sở dữ liệu PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=tunetext_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:your_postgres_password@localhost:5432/tunetext_db

# Bảo mật JWT
JWT_SECRET=super_secret_jwt_key_please_change_in_production_1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cấu hình CORS
CORS_ORIGINS=["*"]

# Cấu hình Cloudflare Tunnel Token
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token
